{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{worker/**,node_modules/pdfjs-dist/legacy/build/*.mjs,node_modules/pdfjs-dist/standard_fonts/*,node_modules/pdfjs-dist/cmaps/*,node_modules/pdfjs-dist/wasm/*}"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
